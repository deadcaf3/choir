#!/bin/sh
# The release gate, in three lanes.
#
#   ./gate        every release check (before a commit or an artifact)
#   ./gate fast   the edit loop: skips the measurement binaries
#   ./gate quick  the sub-minute lane: every check that never invokes
#                 the compiler -- formatting, the internal/ guard, the
#                 book, the advisory audit. It exists so CI can answer
#                 every push inside a minute; it compiles nothing, runs
#                 no tests, and says so when green.
#
# The fast lane is **not a substitute for the full one**, and the rule
# it depends on is that the full lane runs at least every third commit.
# This project's recurring failure is a check that quietly stops
# checking, and "the slow tests are opt-in now" is how that starts.
#
# It fails closed: any stage failing exits nonzero, and the exit code of
# every command is read directly rather than through a pipe, because
# `cargo test | tail` reports tail's status and hides the verdict.
#
# The gate runs in three phases, because cargo holds the build-directory
# lock only while *building* — it releases it before the test binaries
# run (verified by racing `cargo check` against a running `cargo test`).
# So: build everything once up front, then let every suite's run phase
# overlap; only the timing-sensitive binaries wait for a quiet machine.
#
#   1. build   one serial compilation of every debug test target
#   2. overlap the test suites execute in parallel, and clippy, rustdoc
#              and the release builds cycle through the now-idle lock;
#              alloc_budget and throughput run here too, because what they
#              assert survives a loaded machine — allocation counts are
#              deterministic, and throughput's ops/s figures are reports
#              with correctness assertions only (its wall-clock assertion
#              was removed on purpose; its own comment tells the story)
#   3. quiet   suites whose ASSERTIONS are load-sensitive, one at a time
#              on an idle machine: hooks_isolation's admission ceiling,
#              choir-sequencer's drain and p99 ceilings, and
#              retention_cost's off/on ratio — each has failed or would
#              fail healthy code when sharing the machine with another
#              suite
#
# The numbers throughput and alloc_budget PRINT during a gate share the
# machine and are noise; for the report, run them isolated with
# `--nocapture` as their own docs say.
set -u
cd "$(dirname "$0")" || exit 1

LANE=${1:-full}
# An unrecognised lane refuses instead of quietly running the full lane:
# the typo `./gate quikc` silently doing twenty minutes of work is how a
# lane stops being trusted.
case $LANE in
  full | fast | quick | touched) ;;
  *)
    echo "usage: ./gate [touched|fast|quick]   (no argument runs every check)" >&2
    exit 2 ;;
esac

# ----------------------------------------------------------- politeness
# This gate used to take the whole machine and give none of it back.
# Phase 2 launches six cargo invocations at once and each one defaults to
# one build job per core, so an 8-core laptop was asked for up to 48
# concurrent rustc processes. Alone that merely thrashes; beside another
# project's build it turned a 40 s stage into 4m14s, and the machine
# stopped being usable for anything else while the gate ran.
#
# Two fixes, both deliberately unconditional rather than adaptive. A gate
# that behaves differently depending on the load it happened to sample is
# a gate whose timings cannot be compared between runs.
#
#   `nice`  -- the gate yields to whatever else is running. It is never
#              the urgent job: nobody is waiting on it the way they wait
#              on an editor or a test they just typed.
#   `-j`    -- phase 2's fan-out gets a third of the cores each, so the
#              total lands near one job per core instead of six times it.
#
# Re-exec rather than prefixing each invocation, so every child inherits
# it including the ones started by cargo. Test mode is exempt: it runs no
# cargo at all, and forking a second shell for nothing would only make
# the gate's own tests slower.
if [ "${CHOIR_GATE_TEST_MODE:-}" != 1 ] && [ -z "${CHOIR_GATE_NICED:-}" ] \
   && command -v nice >/dev/null 2>&1; then
  CHOIR_GATE_NICED=1
  export CHOIR_GATE_NICED
  exec nice -n 10 sh "$0" "$@"
fi

CORES=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
# Only the lanes that actually overlap invocations. The touched lane runs
# one thing at a time and should have the whole machine for the few
# seconds it needs it.
if [ "$LANE" = full ] || [ "$LANE" = fast ]; then
  if [ -z "${CARGO_BUILD_JOBS:-}" ]; then
    CARGO_BUILD_JOBS=$((CORES / 3))
    [ "$CARGO_BUILD_JOBS" -lt 1 ] && CARGO_BUILD_JOBS=1
    export CARGO_BUILD_JOBS
  fi
fi
# One log directory per checkout, not per machine. Two gates running at
# once — a worktree's and the main checkout's — used to share this
# directory, and the second run's `rm` of the status files handed the
# first a phantom "job died without writing a status" at collection.
LOG=${TMPDIR:-/tmp}/choir-gate-$(pwd | cksum | tr ' ' -)
mkdir -p "$LOG"

# ---------------------------------------------------------------- style
# Colour only when a person is watching. CI captures this output to a
# file and a log full of escape sequences is harder to read, not easier.
ESC=$(printf '\033')
# Two different questions. Colour: does the reader's display render it —
# GitHub Actions does, and it is not a terminal. Live rewriting: can a
# line be redrawn in place, which needs a real terminal or the `\r`
# becomes literal noise in a captured log.
COLOR=0
LIVE=0
if [ -z "${NO_COLOR:-}" ]; then
  { [ -t 1 ] || [ -n "${FORCE_COLOR:-}" ]; } && COLOR=1
  [ -t 1 ] && LIVE=1
fi
if [ "$COLOR" = 1 ]; then
  G="$ESC[32m" R="$ESC[31m" Y="$ESC[33m" D="$ESC[2m" B="$ESC[1m" Z="$ESC[0m"
else
  G= R= Y= D= B= Z=
fi

secs() {
  if [ "$1" -lt 60 ]; then printf '%ss' "$1"
  else printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); fi
}

# A stage begins: on a terminal, show it running so a long gate is
# visibly working rather than apparently hung.
begin() {
  STAGE=$1
  T0=$(date +%s)
  [ "$LIVE" = 1 ] && printf '  %s·%s %-10s %s…%s' "$D" "$Z" "$STAGE" "$D" "$Z"
}

# A stage ends. $1 is its exit status, $2 a short note for the line.
end() {
  _el=$(($(date +%s) - T0))
  finish "$1" "$STAGE" "$2" "$_el"
}

# The line itself, shared by serial stages and collected parallel ones.
# $1 exit status, $2 stage, $3 note, $4 elapsed seconds.
finish() {
  [ "$LIVE" = 1 ] && printf '\r%s[K' "$ESC"
  if [ "$1" -eq 0 ]; then
    printf '  %s✓%s %-10s %s%-18s%s %s%s%s\n' \
      "$G" "$Z" "$2" "$Z" "$3" "$Z" "$D" "$(secs "$4")" "$Z"
  else
    printf '  %s✗%s %-10s %s%-18s%s %s%s%s\n' \
      "$R" "$Z" "$2" "$R" "$3" "$Z" "$D" "$(secs "$4")" "$Z"
    FAILED="$FAILED $2"
  fi
}

# ------------------------------------------------------------- fixtures
# Test-only fault injection for `crates/choir-cli/tests/it/gate.rs`. Test
# mode never runs Cargo; it substitutes success for every stage except
# the named one, so the test proves status propagation without
# recursively invoking this entire gate from inside `cargo test`.
# $1 names the log and the display line; $2 is the key the injection
# fixture matches, which lets the test sub-stages share one key while
# reporting themselves separately.
run() {
  _logfile=$LOG/$1.log _stage=$2
  shift 2
  if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ]; then
    if [ "${CHOIR_GATE_INJECT_FAILURE:-}" = "$_stage" ]; then
      echo "injected $_stage failure" >"$_logfile"
      return 97
    fi
    : >"$_logfile"
    return 0
  fi
  "$@" >"$_logfile" 2>&1
}

# A background job around `run`: records its own exit code and duration,
# because `wait` can only return one of them and the collector needs
# both. A missing status file means the job died without reporting,
# which fails closed like everything else here.
job() {
  _name=$1
  _j0=$(date +%s)
  shift
  run "$_name" "$@"
  _jc=$?
  echo "$_jc $(($(date +%s) - _j0))" >"$LOG/$_name.status"
}

# Collect one background job: $1 its pid, $2 the log/status name, $3 the
# display name, $4 a note command evaluated against the finished log.
collect() {
  [ "$LIVE" = 1 ] && printf '  %s·%s %-10s %s…%s' "$D" "$Z" "$3" "$D" "$Z"
  wait "$1"
  if [ -r "$LOG/$2.status" ]; then
    read -r _code _dur <"$LOG/$2.status"
  else
    _code=98 _dur=0
    echo "job for $2 died without writing a status" >>"$LOG/$2.log"
  fi
  finish "$_code" "$3" "$(eval "$4")" "$_dur"
}

# The measurement binaries, skipped by the fast lane: throughput ~36 s,
# alloc_budget ~13 s, retention_cost ~7 s.
#
# `budget` is deliberately **not** here despite being the same kind of
# test. It used to be 158 s -- half the entire gate -- and is now under a
# second, because its iteration count learned the difference between a
# debug and a release build. A test that cheap costs nothing to keep in,
# and every test kept in is one the fast lane does not have to be trusted
# about.
# The Phase-1 target measurements (D64) belong here for the reason
# stated below rather than for their runtime: they assert
# release-profile ceilings. Run under the debug allocator alongside a
# fully parallel suite, the repository front page measured p99 627 ms
# against a ceiling that release clears with room -- a healthy build
# failing on the profile it was never measured in.
SLOW="alloc_budget retention_cost throughput phase1_reads phase1_clones phase1_spawns"

# Debug-build tests that assert a wall-clock ceiling. They run in the
# quiet phase in BOTH lanes: hooks_isolation's 2 s admission ceiling has
# been exceeded by gate parallelism alone while passing 3/3 isolated at
# the same machine load, and a timing test that shares the machine with
# another suite reports on the scheduler, not on the code. choir-sequencer
# is quarantined whole for the same reason: group_commit asserts a 50 ms
# drain ceiling and concurrency a p99 latency ceiling.
ISOLATED="hooks_isolation"

# ---------------------------------------------------------- touched lane
# Which crates this working tree has actually changed, as `-p` arguments.
#
# Both halves matter: `git diff HEAD` sees edits to tracked files, and
# `ls-files --others` sees a new file that has never been added -- which
# is how a whole new module reads until it is staged, and exactly the
# thing an edit loop most wants tested.
PKGS=
touched_pkgs() {
  { git diff --name-only HEAD 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null
  } | sed -n 's|^crates/\([^/]*\)/.*|-p \1|p' | sort -u | tr '\n' ' '
}

# A build input outside `crates/` that no `-p` selection can cover.
touched_root() {
  { git diff --name-only HEAD 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null
  } | grep -E '^(Cargo\.toml|Cargo\.lock|rust-toolchain.*)$' | tr '\n' ' '
}

count_of() {
  awk '/^test result:/ {
    for (i = 1; i <= NF; i++) {
      if ($i == "passed;") p += $(i-1);
      if ($i == "failed;") f += $(i-1);
    }
  } END { if (f) printf "%d ok, %d failed", p, f; else printf "%d ok", p }' "$1"
}

t_touched() { cargo test $PKGS --no-fail-fast; }
c_touched() { cargo clippy $PKGS --all-targets -- -D warnings; }

fast_targets() {
  for f in crates/choir-node/tests/*.rs; do
    name=$(basename "$f" .rs)
    case " $SLOW $ISOLATED " in *" $name "*) continue ;; esac
    printf ' --test %s' "$name"
  done
  printf ' --test it'   # the merged harness, crates/choir-node/tests/it/
}

# Doctests are their own invocation because cargo refuses `--doc`
# alongside any other target selector. The measurement targets are their
# own because they state release-profile ceilings: running them under the
# debug allocator makes the number meaningless and can fail a healthy
# release.
b_workspace() {
  cargo test --workspace --no-run --exclude choir-node --exclude choir-sequencer \
    && cargo test -p choir-sequencer --no-run
}
# shellcheck disable=SC2046
b_node()      { cargo test -p choir-node --no-run --lib --bins $(fast_targets) --test "$ISOLATED"; }
# shellcheck disable=SC2046
b_node_fast() { cargo test -p choir-node --no-run --lib $(fast_targets) --test "$ISOLATED"; }
build_debug() { b_workspace && if [ "$LANE" = fast ]; then b_node_fast; else b_node; fi; }

t_workspace() { cargo test --workspace --no-fail-fast --exclude choir-node --exclude choir-sequencer; }
# shellcheck disable=SC2046
t_node()      { cargo test -p choir-node --no-fail-fast --lib --bins $(fast_targets); }
# shellcheck disable=SC2046
t_node_fast() { cargo test -p choir-node --no-fail-fast --lib $(fast_targets); }
t_doc()       { cargo test -p choir-node --doc; }
# Both quarantined suites run even if the first fails: the report should
# name everything that is broken, not the first thing.
t_isolated()  {
  _tc=0
  cargo test -p choir-node --test "$ISOLATED" || _tc=1
  cargo test -p choir-sequencer --no-fail-fast || _tc=1
  return $_tc
}
# The overlap-phase half of the measurement suite. Builds first —
# compilation wants the lock, which the test suites are no longer
# holding, and retention_cost and spike must be ready before the quiet
# phase so it starts quiet — then runs the two load-immune binaries.
t_measure()   {
  cargo test -p choir-node --release --no-run --test retention_cost \
    && cargo build --release -p choir-spike \
    && cargo test -p choir-node --release --no-fail-fast \
         --test alloc_budget --test throughput \
         --test phase1_spawns --test phase1_clones --test phase1_reads \
    && cargo test -p choir-queue --release --no-fail-fast --test phase1
}
# The quiet-phase half: the one measurement whose assertion is a
# wall-clock ratio and has failed healthy code under suite contention.
t_retention() { cargo test -p choir-node --release --no-fail-fast --test retention_cost; }

# The object-database scan. The needles are the strings that must not be
# in any reachable blob -- a removed hosted repository's name, and
# anything else whose return would be a privacy regression rather than a
# bug. They live in an untracked file for the obvious reason: a tracked
# gate that names the removed string reintroduces it, and the next run of
# this very scan would fail on the gate itself.
#
# Absent file = skipped, and the gate says so. A fresh clone has no
# `internal/`, and so does CI, which means **this guard runs locally
# only**. An *empty* file is a failure rather than a skip, the same way
# an empty ACL and an absent one mean opposite things: someone emptied
# the guard, which is not the same as never having had one.
NEEDLES=internal/scan-needles

scan_needles() {
  set --
  while IFS= read -r line; do
    case "$line" in '' | \#*) continue ;; esac
    set -- "$@" "$line"
  done < "$NEEDLES"
  if [ $# -eq 0 ]; then
    echo "$NEEDLES exists but names no strings; a guard with nothing to guard is a failure"
    return 1
  fi
  sh scripts/scan_history.sh "$@"
}

# Nothing under `internal/` may ever be tracked. The directory is the
# unpublished half of this repository, and the only thing keeping it out
# is a bare `.gitignore` entry that a single `git add -f` defeats
# without comment. The count is printed and the paths are not: a guard
# against leaking private file names must not leak them into a build log
# in order to report itself.
tracked_guard() {
  _tracked=$(git ls-files -- internal | wc -l | tr -d ' ')
  if [ "$_tracked" != 0 ]; then
    echo "$_tracked path(s) under internal/ are tracked; internal/ is never published"
    echo "run 'git ls-files internal' to see which"
    return 1
  fi
  return 0
}

# ----------------------------------------------------------------- run
MARK="$LOG/start"
: >"$MARK"
rm -f "$LOG"/*.status
FAILED=
STARTED=$(date +%s)

printf '\n  %schoir%s %s%s gate%s\n\n' "$B" "$Z" "$D" "$LANE" "$Z"

# The scan walks the object database with git and never touches cargo, so
# it holds no build lock and has no reason to wait its turn. Started here
# and collected at the end, it costs the gate nothing instead of ~26 s.
SCAN_PID=
if [ "$LANE" != fast ] && [ "$LANE" != touched ]; then
  if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ] || [ -f "$NEEDLES" ]; then
    job scan scan scan_needles &
    SCAN_PID=$!
  else
    echo "no $NEEDLES: the object-database scan is skipped" >"$LOG/scan.log"
  fi
fi

# The advisory audit is the other stage with no interest in the build
# lock: it reads Cargo.lock and the RustSec database, nothing else.
# Skipped in the fast lane -- the edit loop should not need the network
# -- and announced when the binary is absent, the same rule the book
# follows.
AUDIT_PID=
if [ "$LANE" != fast ] && [ "$LANE" != touched ]; then
  if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ] || command -v cargo-audit >/dev/null 2>&1; then
    job audit audit cargo audit &
    AUDIT_PID=$!
  else
    echo "no cargo-audit: the advisory audit is skipped" >"$LOG/audit.log"
  fi
fi

# Announced, not silent, when this is not a git checkout (a tarball):
# the guard cannot ask git what is tracked there.
if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ] || git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  begin tracked
  run tracked tracked tracked_guard
  end $? ""
else
  printf '  %s-  %-10s %s%s\n' "$D" tracked "not a git checkout" "$Z"
fi

begin format
run format format cargo fmt --all -- --check
end $? ""

# The quick lane's cargo involvement ends at `cargo fmt`: no build, no
# tests, no clippy, no rustdoc. Sixty seconds is its budget, and this
# suite's test execution alone runs for minutes.
if [ "$LANE" = touched ]; then

# The touched lane: the changed crates, their tests, their lints, and
# nothing else. It is the edit loop's rung and it is NOT a smaller full
# lane -- it does not test the crates that depend on the ones it ran, it
# builds no release profile, and it renders no docs. What it buys is the
# difference between 46 s and 4 minutes, which is the difference between
# running the suite on every edit and running it when you remember to.
PKGS=$(touched_pkgs)
ROOT_CHANGED=$(touched_root)
if [ -z "$PKGS" ]; then
  printf '  %s-  %-10s %s%s\n' "$D" touched "nothing under crates/" "$Z"
else
  begin touched
  run touched tests t_touched
  end $? "$(count_of "$LOG/touched.log")"

  begin clippy
  run clippy clippy c_touched
  end $? ""
fi

elif [ "$LANE" != quick ]; then

# Phase 1: one serial build of every debug test target, under the lock.
# Its failure key is `tests` — a test that does not compile is a failed
# test, and the injection fixture treats it the same way.
begin build
run build tests build_debug
end $? ""

# Phase 2: the overlap. Everything is prebuilt, so the test invocations
# clear the lock in about a second of freshness checking each and then
# only *run*; clippy, rustdoc and the release builds queue up behind
# them and compile while the suites execute. Launch order is the lock
# queue: runners first, compilers last. If the build stage failed, run
# the suites anyway (`--no-fail-fast` for invocations) — cargo repeats
# the same failure cheaply and the report names every broken stage.
if [ "$LANE" = fast ]; then
  job node tests t_node_fast & NODE_PID=$!
else
  job node tests t_node & NODE_PID=$!
fi
job workspace tests t_workspace & WS_PID=$!
job doctests tests t_doc & DOC_PID=$!
# The lock has no queue discipline: on a changed tree, a compiler that
# wins it first would stall every runner behind a long recompile. Give
# the runners a head start to clear their freshness checks.
[ "${CHOIR_GATE_TEST_MODE:-}" = 1 ] || sleep 3
job clippy clippy cargo clippy --workspace --all-targets -- -D warnings & CLIPPY_PID=$!
job rustdoc rustdoc env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps & RUSTDOC_PID=$!
MEASURE_PID=
if [ "$LANE" != fast ]; then
  job measure tests t_measure & MEASURE_PID=$!
fi

collect "$WS_PID" workspace workspace 'count_of "$LOG/workspace.log"'
collect "$NODE_PID" node node 'count_of "$LOG/node.log"'
collect "$DOC_PID" doctests doctests 'count_of "$LOG/doctests.log"'
collect "$CLIPPY_PID" clippy clippy 'echo'
collect "$RUSTDOC_PID" rustdoc rustdoc 'echo'
[ -n "$MEASURE_PID" ] && collect "$MEASURE_PID" measure measure 'count_of "$LOG/measure.log"'

# Phase 3: quiet. Timing-sensitive suites get the machine to themselves,
# one at a time — everything above has finished, and everything they
# need is already built. Quiet includes the disk: the overlap ends with
# thousands of scratch files awaiting lazy writeback, and spike's CoW
# provisioning ceiling (p50 < 50 ms warm) failed at 73 ms while that
# backlog flushed underneath it — then passed isolated at 15 ms
# immediately after. Drain it here so the quiet suites measure the code,
# not the flush.
[ "${CHOIR_GATE_TEST_MODE:-}" = 1 ] || sync

begin isolation
run isolation tests t_isolated
end $? "$(count_of "$LOG/isolation.log")"

# end of the quick-lane bypass: from here every lane runs again
fi

# The book over the same `docs/` files rustdoc just compiled. It is a
# separate renderer and can fail on its own: a SUMMARY.md entry naming a
# file that does not exist is caught here and nowhere else, because
# `create-missing` is off and mdBook refuses rather than writing a stub.
#
# Skipped, announced, when mdbook is absent -- the same rule the object
# scan follows. A contributor without the tool still gets a green gate,
# and nobody gets a silent pass: the line says which it was.
if [ "$LANE" = touched ]; then
  :
elif command -v mdbook >/dev/null 2>&1 || [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ]; then
  begin book
  run book book mdbook build
  end $? ""
else
  printf '  %s-  %-10s %s%s\n' "$D" book "no mdbook" "$Z"
fi

if [ "$LANE" = full ]; then
  begin retention
  run retention tests t_retention
  end $? "$(count_of "$LOG/retention.log")"

  begin spike
  run spike spike cargo run -p choir-spike --release
  end $? ""
fi

begin freshness
if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ]; then
  run freshness freshness true
  FRESH=$?
else
  find crates scripts docs templates theme Cargo.toml Cargo.lock book.toml \
    README.md DECISIONS.md SYNC.md gate \
    -newer "$MARK" -print >"$LOG/freshness.log" 2>/dev/null
  [ ! -s "$LOG/freshness.log" ]
  FRESH=$?
fi
# A receipt describes the tree as of the gate's start. Edit anything
# after the run begins, including a comment, and the receipt is void.
end $FRESH "$([ $FRESH -eq 0 ] || echo 'tree changed')"

if [ -n "$AUDIT_PID" ]; then
  collect "$AUDIT_PID" audit audit 'echo'
elif [ "$LANE" != fast ] && [ "$LANE" != touched ]; then
  printf '  %s-  %-10s %s%s\n' "$D" audit "no cargo-audit" "$Z"
fi

if [ -n "$SCAN_PID" ]; then
  collect "$SCAN_PID" scan scan \
    'sed -n "s/^scanning \([0-9]*\) objects.*/\1 objects/p" "$LOG/scan.log"'
elif [ "$LANE" != fast ] && [ "$LANE" != touched ]; then
  printf '  %s-  %-10s %s%s\n' "$D" scan "no $NEEDLES" "$Z"
fi

# -------------------------------------------------------------- report
# Detail only for what failed. A green gate should be a screenful, not a
# transcript nobody reads; a red one should put the reason on screen
# without a second command.
for stage in $FAILED; do
  printf '\n%s── %s ──%s\n' "$R" "$stage" "$Z"
  case $stage in
    workspace | node | doctests | isolation | measure | retention)
      grep -E '^(test .* FAILED|error(\[|:)|thread .* panicked)' "$LOG/$stage.log" | head -20 ;;
    build)
      grep -E '^error(\[|:)' "$LOG/$stage.log" | head -20 ;;
    clippy)  grep -E '^(warning|error)' "$LOG/clippy.log" | head -20 ;;
    rustdoc) grep -E '^(warning|error)' "$LOG/rustdoc.log" | head -20 ;;
    format)  head -20 "$LOG/format.log" ;;
    tracked) head -20 "$LOG/tracked.log" ;;
    audit)   tail -20 "$LOG/audit.log" ;;
    spike)   tail -20 "$LOG/spike.log" ;;
    scan)    head -20 "$LOG/scan.log" ;;
    freshness)
      echo "these changed while the gate ran, so its receipt is void:"
      head -20 "$LOG/freshness.log" ;;
  esac
  printf '%s  full log: %s%s\n' "$D" "$LOG/$stage.log" "$Z"
done

TOTAL=$(($(date +%s) - STARTED))
if [ -z "$FAILED" ]; then
  printf '\n  %sgreen%s in %s\n\n' "$G" "$Z" "$(secs $TOTAL)"
  if [ "$LANE" = touched ]; then
    printf '  %stouched lane: %s%s\n' "$Y" "${PKGS:-no crates}" "$Z"
    printf '  %stheir dependents were not tested; ./gate fast before you commit%s\n\n' \
      "$Y" "$Z"
    [ -n "${ROOT_CHANGED:-}" ] && printf \
      '  %s%s changed, which no -p selection covers: run ./gate fast%s\n\n' \
      "$Y" "$ROOT_CHANGED" "$Z"
  fi
  [ "$LANE" = fast ] && printf '  %sfast lane: run ./gate at least every third commit%s\n\n' "$Y" "$Z"
  [ "$LANE" = quick ] && printf '  %squick lane: nothing was compiled and no tests ran%s\n\n' "$Y" "$Z"
  exit 0
fi
printf '\n  %sfailed:%s%s  in %s\n\n' "$R" "$FAILED" "$Z" "$(secs $TOTAL)"
exit 1
