#!/bin/sh
# The release gate, in two lanes. The same full lane runs locally and in CI.
#
#   sh scripts/gate fast   everything except the measurement binaries
#   sh scripts/gate full   every release check (before a commit or artifact)
#
# The fast lane is for the edit loop. **It is not a substitute for the
# full lane**, and the rule it depends on is that the full lane runs
# before every commit. This project's recurring failure is a check that
# quietly stops checking, and "the slow tests are opt-in now" is how that
# starts.
#
# Exit codes come from each command directly, never through a pipe:
# `cargo test | tail` reports tail's status and hides the verdict.
set -u
cd "$(dirname "$0")/.." || exit 1
LOG=${TMPDIR:-/tmp}/choir-gate
mkdir -p "$LOG"

# Test-only fault injection for the regression in
# `crates/choir-cli/tests/it/gate.rs`. Test mode never runs Cargo; it
# substitutes success for every stage except the named injected one, so
# the test proves status propagation without recursively invoking this
# entire gate from inside `cargo test`.
run_check() {
  stage=$1
  logfile=$2
  shift 2
  if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ]; then
    if [ "${CHOIR_GATE_INJECT_FAILURE:-}" = "$stage" ]; then
      echo "injected $stage failure" >"$logfile"
      return 97
    fi
    : >"$logfile"
    return 0
  fi
  "$@" >"$logfile" 2>&1
}

freshness_check() {
  output=$1
  if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ]; then
    if [ "${CHOIR_GATE_INJECT_FAILURE:-}" = freshness ]; then
      echo "injected freshness failure" >"$output"
      return 97
    fi
    : >"$output"
    return 0
  fi
  find crates scripts docs templates Cargo.toml Cargo.lock README.md DECISIONS.md SYNC.md \
    -newer "$MARK" -print >"$output" 2>/dev/null
  [ ! -s "$output" ]
}

# The measurement binaries, skipped by the fast lane: throughput ~36 s,
# alloc_budget ~13 s, retention_cost ~7 s.
#
# `budget` is deliberately **not** here despite being the same kind of
# test. It used to be 158 s -- half the entire gate -- and is now under a
# second, because its iteration count learned the difference between a
# debug and a release build. A test that cheap costs nothing to keep in,
# and every test kept in is one the fast lane does not have to be trusted
# about.
SLOW="alloc_budget retention_cost throughput"

fast_targets() {
  # Every choir-node integration target except the four above.
  for f in crates/choir-node/tests/*.rs; do
    name=$(basename "$f" .rs)
    case " $SLOW " in *" $name "*) continue ;; esac
    printf ' --test %s' "$name"
  done
  printf ' --test it'   # the merged harness, crates/choir-node/tests/it/
}

full_tests() {
  # The three measurement targets state and enforce release-profile
  # ceilings. Running them under the debug allocator/optimizer makes the
  # number meaningless and can fail a healthy release. Everything still
  # runs: ordinary targets in debug, measurements in release.
  cargo test --workspace --no-fail-fast --exclude choir-node
  a=$?
  # shellcheck disable=SC2046
  cargo test -p choir-node --no-fail-fast --lib --bins $(fast_targets)
  b=$?
  cargo test -p choir-node --doc
  c=$?
  cargo test -p choir-node --release --no-fail-fast \
    --test alloc_budget --test retention_cost --test throughput
  d=$?
  [ "$a" -eq 0 ] && [ "$b" -eq 0 ] && [ "$c" -eq 0 ] && [ "$d" -eq 0 ]
}

# The object-database scan, wired here because a check that only runs
# when someone remembers it is the failure this project keeps repeating.
# The needles are the strings that must not be in any reachable blob --
# a removed hosted repository's name, and anything else whose return
# would be a privacy regression rather than a bug.
#
# They live in an untracked file for the obvious reason: a tracked gate
# that names the removed string reintroduces it, and the next run of this
# very scan would fail on the gate itself.
#
# Absent file = skipped, and the gate says so. A fresh clone has no
# `internal/`, and so does CI, which means **this guard runs locally
# only**. An *empty* file is a failure rather than a skip, the same way
# an empty ACL and an absent one mean opposite things: someone emptied
# the guard, which is not the same as never having had one.
NEEDLES=internal/scan-needles

scan_needles() {
  set --
  while IFS= read -r line; do
    case "$line" in '' | \#*) continue ;; esac
    set -- "$@" "$line"
  done < "$NEEDLES"
  if [ $# -eq 0 ]; then
    echo "$NEEDLES exists but names no strings; a guard with nothing to guard is a failure"
    return 1
  fi
  sh scripts/scan_history.sh "$@"
}

MARK="$LOG/start"
: >"$MARK"

run_check format "$LOG/format.log" cargo fmt --all -- --check
FORMAT_EXIT=$?

if [ "${1:-full}" = "fast" ]; then
  echo "== fast lane: skipping $SLOW =="
  if [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ]; then
    run_check tests "$LOG/test.log" true
    TEST_EXIT=$?
  else
    # shellcheck disable=SC2046
    cargo test --workspace --no-fail-fast --exclude choir-node >"$LOG/test.log" 2>&1
    A=$?
    # shellcheck disable=SC2046
    cargo test -p choir-node --no-fail-fast --lib $(fast_targets) >>"$LOG/test.log" 2>&1
    B=$?
    # Doctests are separate because cargo refuses `--doc` alongside any
    # other target selector.
    cargo test -p choir-node --doc >>"$LOG/test.log" 2>&1
    C=$?
    [ "$A" -eq 0 ] && [ "$B" -eq 0 ] && [ "$C" -eq 0 ]
    TEST_EXIT=$?
  fi
  SPIKE_EXIT=0
else
  run_check tests "$LOG/test.log" full_tests
  TEST_EXIT=$?
  run_check spike "$LOG/spike.log" cargo run -p choir-spike --release
  SPIKE_EXIT=$?
fi

run_check clippy "$LOG/clippy.log" cargo clippy --workspace --all-targets -- -D warnings
CLIPPY_EXIT=$?
run_check rustdoc "$LOG/doc.log" env RUSTDOCFLAGS=-Dwarnings cargo doc --workspace --no-deps
DOC_EXIT=$?

if [ "${1:-full}" = "fast" ]; then
  echo "history scan: skipped by the fast lane (~26 s)" >"$LOG/scan.log"
  SCAN_EXIT=0
elif [ "${CHOIR_GATE_TEST_MODE:-}" = 1 ] || [ -f "$NEEDLES" ]; then
  run_check scan "$LOG/scan.log" scan_needles
  SCAN_EXIT=$?
else
  echo "no $NEEDLES: the object-database scan is skipped" >"$LOG/scan.log"
  SCAN_EXIT=0
fi

freshness_check "$LOG/freshness.log"
FRESHNESS_EXIT=$?

echo "FORMAT_EXIT=$FORMAT_EXIT  TEST_EXIT=$TEST_EXIT  CLIPPY_EXIT=$CLIPPY_EXIT"
echo "DOC_EXIT=$DOC_EXIT  SPIKE_EXIT=$SPIKE_EXIT  FRESHNESS_EXIT=$FRESHNESS_EXIT"
echo "SCAN_EXIT=$SCAN_EXIT"
sed -n '1,12p' "$LOG/scan.log"
awk '/^test result:/ {
  for (i = 1; i <= NF; i++) {
    if ($i == "passed;")  p += $(i-1);
    if ($i == "failed;")  f += $(i-1);
    if ($i == "ignored;") g += $(i-1);
  }
} END { printf "passed %d  failed %d  ignored %d\n", p, f, g }' "$LOG/test.log"
grep -E '^(test .* FAILED|error(\[|:))' "$LOG/test.log" | head -30

echo "clippy warn/error lines: $(grep -cE '^(warning|error)' "$LOG/clippy.log")"
grep -E '^(warning|error)' "$LOG/clippy.log" | head -20
echo "rustdoc warn/error lines: $(grep -cE '^(warning|error)' "$LOG/doc.log")"
grep -E '^(warning|error)' "$LOG/doc.log" | head -20

# A receipt describes the tree at its start. Edit anything after the run
# begins, including a comment, and the receipt above is void.
echo "--- freshness (must be empty) ---"
sed -n '1,30p' "$LOG/freshness.log"

if [ "$FORMAT_EXIT" -ne 0 ] || [ "$TEST_EXIT" -ne 0 ] \
  || [ "$CLIPPY_EXIT" -ne 0 ] || [ "$DOC_EXIT" -ne 0 ] \
  || [ "$SPIKE_EXIT" -ne 0 ] || [ "$FRESHNESS_EXIT" -ne 0 ] \
  || [ "$SCAN_EXIT" -ne 0 ]; then
  exit 1
fi
exit 0
