#!/bin/zsh
# One entry point for the dogfood node, so nothing has to be memorized.
# Run it with no arguments to see what it can do.
#
# Everything here delegates to the scripts next to it; this file adds no
# behaviour of its own beyond the status/logs conveniences.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
STATE=$HOME/.choir
LABEL=com.choir.node
PORT=${CHOIR_PORT:-8417}

auth_user() { head -1 "$STATE/auth" | cut -d: -f1; }
auth_pass() { head -1 "$STATE/auth" | cut -d: -f2-; }

case "${1:-}" in

install)
  # Build, mint secrets, load the supervised LaunchAgent. Idempotent.
  sh "$HERE/flip/install_node.sh" "$PORT" "${2:-choir/choir.git}"
  ;;

status)
  if launchctl print "gui/$(id -u)/$LABEL" > /dev/null 2>&1; then
    echo "agent:  loaded ($LABEL)"
  else
    echo "agent:  not loaded — run: sh scripts/choirctl install"
    exit 1
  fi
  # Which binary is actually serving, not merely whether something is.
  # `launchctl kickstart -k` restarts the job from launchd's cached job
  # definition, so a plist whose ProgramArguments changed can lint clean,
  # restart cleanly, and still run the old binary. An API-shaped check
  # cannot catch that when both binaries have the feature you are testing
  # for; only the path can. Reloading properly is bootout then bootstrap.
  echo "binary: $(ps -eo args | grep "[c]hoir-node" | head -1 | awk '{print $1}')"
  code=$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PORT/api/view" || true)
  echo "auth:   $code on an unauthenticated /api/view (401 = auth is on)"
  echo "view:   $(curl -s -u "$(auth_user):$(auth_pass)" "http://127.0.0.1:$PORT/api/view")"
  ;;

stop)
  # Unloads for this boot only: the plist stays in LaunchAgents, so
  # launchd starts it again at next login. Use uninstall to end it.
  launchctl bootout "gui/$(id -u)/$LABEL"
  echo "stopped $LABEL — but it returns at next login"
  echo "to end it for good: sh scripts/choirctl uninstall"
  ;;

uninstall)
  # Stop it and remove the plist, so it does not come back. Data is
  # deliberately kept: $STATE holds the keys, the repos, and the op log.
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$HOME/Library/LaunchAgents/$LABEL.plist"
  echo "uninstalled $LABEL (agent unloaded, plist removed)"
  echo "kept: $STATE — keys, repos and the op log"
  echo "to erase that too, by hand: rm -rf $STATE"
  ;;

push)
  # Local repo -> the choir node, as the canonical remote (--all + --tags).
  sh "$HERE/flip/push_canonical.sh" "$PORT" "${2:-choir/choir.git}"
  ;;

mirror)
  # Repo -> the private Forgejo follower on the mirror VM.
  sh "$HERE/push_mirror.sh"
  ;;

sync)
  # The post-flip order, in one command: canonical first, follower
  # second. `set -e` stops here if the canonical push fails, so the
  # mirror can never get ahead of the node (D21 single-canonical).
  sh "$HERE/flip/push_canonical.sh" "$PORT" "${2:-choir/choir.git}"
  sh "$HERE/push_mirror.sh"
  ;;

logs)
  tail -n "${2:-30}" "$STATE/node.log"
  ;;

url)
  # Clone/push URL with credentials, for pasting into git or curl.
  echo "http://$(auth_user):$(auth_pass)@127.0.0.1:$PORT/${2:-choir/choir.git}"
  ;;

*)
  cat <<USAGE
sh scripts/choirctl <command>

  install [repo]   build + mint secrets + load the supervised daemon
  status           is it running, is auth on, what does the view say
  logs [n]         last n lines of the daemon log
  stop             unload it for now (it returns at next login)
  uninstall        unload it and remove the agent (data kept)

  sync [repo]      push to the node, then the follower (the usual one)
  push [repo]      push this repo to the node only (--all and --tags)
  mirror           push to the private Forgejo follower only
  url [repo]       clone/push URL including credentials

Port is $PORT (override with CHOIR_PORT). Runbook: scripts/flip/RUNBOOK.md
USAGE
  ;;
esac
