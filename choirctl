#!/bin/zsh
# One entry point for the dogfood node, so nothing has to be memorized.
# Run it with no arguments to see what it can do.
#
# Everything here delegates to the scripts next to it; this file adds no
# behaviour of its own beyond the status/logs conveniences.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
STATE=$HOME/.choir
# The pull destination, spelled once. `pull_backup.sh` defaults to the
# same path; two spellings of it drifted apart and `status` spent a week
# reporting NEVER PULLED at a directory nothing ever wrote.
BACKUP=$HOME/choir-backup
LABEL=com.choir.node
PORT=${CHOIR_PORT:-8417}

auth_user() { head -1 "$STATE/auth" | cut -d: -f1; }
auth_pass() { head -1 "$STATE/auth" | cut -d: -f2-; }

# The operator-side CLI, built by `choirctl install`. The review and
# verdict passthroughs refuse rather than guess when it is missing: a
# wrong path found via PATH could be a stale binary signing real ops.
choir_bin() {
  local bin="$HERE/target/release/choir"
  [ -x "$bin" ] || { echo "choirctl: no CLI at $bin — build it: cargo build --release -p choir-cli" >&2; exit 1; }
  echo "$bin"
}

# After the D20 host move the canonical node lives on the mirror VM and
# every 127.0.0.1:$PORT below reaches it through an SSH -L forward. The
# marker is what says which world this machine is in; the scripts that
# only make sense in one of them check it and refuse in the other.
remote_node() { [ -f "$STATE/node-remote" ]; }

# Once the node serves TLS publicly, ~/.choir-public-url holds the base
# (e.g. https://<domain>:<port>) and every HTTP leg goes straight to it
# — the cert verifies, the hairpin from the node host to its own public
# name works, and the tunnel stops being load-bearing for HTTP. The
# file is untracked on purpose: hostnames stay out of the repo. Without
# it, everything reaches the node as plaintext over the tunnel exactly
# as before the flip.
api_base() {
  if [ -f "$HOME/.choir-public-url" ]; then
    cat "$HOME/.choir-public-url"
  else
    echo "http://127.0.0.1:$PORT"
  fi
}

# Idempotent: -O check asks the existing master, and only a missing one
# opens a new forward. ControlPersist outlives the command so the next
# one is instant, same reasoning as the mirror scripts' socket.
tunnel_up() {
  local ip ctl key
  # Public TLS makes the HTTP forward unnecessary; ssh legs (node_ssh,
  # pulls, mirrors) hold their own connections and never needed it.
  [ -f "$HOME/.choir-public-url" ] && return 0
  ip=$(cat "$HOME/.choir-mirror-ip")
  key=$HOME/.ssh/choir_bench_ed25519
  ctl=$HOME/.ssh/cm-choir-tunnel.sock
  if ! ssh -o ControlPath="$ctl" -O check "choir@$ip" 2>/dev/null; then
    ssh -i "$key" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 \
        -o ControlMaster=auto -o ControlPath="$ctl" -o ControlPersist=600 \
        -f -N -L "$PORT:127.0.0.1:$PORT" "choir@$ip"
  fi
}

# One ssh for the remote-node cases below, same options as the tunnel.
node_ssh() {
  local ip
  ip=$(cat "$HOME/.choir-mirror-ip")
  ssh -i "$HOME/.ssh/choir_bench_ed25519" -o IdentitiesOnly=yes -o BatchMode=yes \
      -o ConnectTimeout=10 -o ControlMaster=auto \
      -o ControlPath="$HOME/.ssh/cm-choir-mirror.sock" -o ControlPersist=600 \
      "choir@$ip" "$@"
}

# The followers are fed on-box from the node's own bare repos, so none
# can ever hold a commit the canonical node has not sequenced (D21).
# Every repo in the node host's ~/.choir/repos.list is pushed, not just
# the canonical one: an imported repo can leave the node the only holder
# of its git objects, and a follower that mirrors one repo reads like a
# follower that mirrors all of them.
#
# A follower is any remote the bare repo carries. A bare repo on the
# node has no origin, it *is* the origin, so every remote on it is one
# an operator added on purpose, and enumerating them is what makes this
# list-free: adding a public mirror is `git remote add` on the node host
# and nothing here to edit. This used to name `forgejo` and push to it
# alone, which was the same list-of-one that has rotted here before.
# A repo with no remote at all is named on every run rather than
# silently skipped — unconfigured means "no second copy yet", and that
# should stay annoying until an operator configures one. Exit is
# nonzero only when a configured push fails.
#
# No force, deliberately. A follower that diverged from the node is a
# fault to surface, not a state to overwrite, and a push that refuses
# is the whole of that surfacing.
follower_feed() {
  node_ssh '
    [ -f "$HOME/.choir/repos.list" ] || { echo "follower: no repos.list on the node host" >&2; exit 1; }
    failed=
    while IFS= read -r repo; do
      case $repo in ""|"#"*) continue ;; esac
      bare=$HOME/.choir/repos/$repo
      remotes=$(git --git-dir "$bare" remote 2>/dev/null)
      if [ -z "$remotes" ]; then
        echo "follower: $repo has NO remote — its objects have no second copy yet" >&2
        continue
      fi
      for follower in $remotes; do
        if git --git-dir "$bare" push -q "$follower" "refs/heads/*:refs/heads/*" "refs/tags/*:refs/tags/*"; then
          echo "follower updated: $repo -> $follower"
        else
          echo "follower: push FAILED for $repo -> $follower" >&2
          failed=1
        fi
      done
    done < "$HOME/.choir/repos.list"
    [ -z "$failed" ]
  '
}

# The mirror leg runs detached, so its result has to be written down and
# then actually read somewhere an operator looks. A receipt nobody reads
# is the same as no receipt: before this, a mirror push could fail and
# the only evidence was that no error scrolled past during a sync.
RECEIPT=$STATE/mirror.receipt

# OK | FAILED | RUNNING | NONE. The lock, not the receipt, distinguishes
# "still going" from "died halfway" — a run killed mid-flight leaves a
# truncated receipt that is indistinguishable from a slow one otherwise.
mirror_outcome() {
  if [ ! -f "$RECEIPT" ]; then echo NONE; return; fi
  if [ -d "$STATE/mirror.lock" ]; then echo RUNNING; return; fi
  if tail -1 "$RECEIPT" | grep -q '^mirror updated$'; then echo OK; else echo FAILED; fi
}

mirror_line() {
  case "$(mirror_outcome)" in
    NONE)    echo "mirror: no receipt yet" ;;
    RUNNING) echo "mirror: still running (started $(date -r "$(awk 'NR==1{print $2}' "$RECEIPT")" '+%H:%M:%S' 2>/dev/null))" ;;
    OK)      echo "mirror: last run OK — $(grep '^mirror:' "$RECEIPT" | tail -1 | sed 's/^mirror: //')" ;;
    FAILED)  echo "mirror: LAST RUN FAILED — $(tail -1 "$RECEIPT")" ;;
  esac
}


# ---------------------------------------------------------------- style
# The same two questions `./gate` asks, answered the same way: colour when
# the display renders it, redrawing only on a real terminal. Duplicated
# rather than sourced because these are twelve lines and a shared file
# between a sh script and a zsh one is a third thing to keep working.
ESC=$(printf '\033')
COLOR=0; LIVE=0
if [ -z "${NO_COLOR:-}" ]; then
  # Written as `if` rather than `[ … ] && x=1`: under `set -e` a trailing
  # `&&` whose test fails is a nonzero status, and a nonzero status is
  # the end of the script. That is how this file first aborted after
  # printing exactly its header and nothing else.
  if [ -t 1 ] || [ -n "${FORCE_COLOR:-}" ]; then COLOR=1; fi
  if [ -t 1 ]; then LIVE=1; fi
fi
if [ "$COLOR" = 1 ]; then
  # Braced. This file is zsh, where `"$ESC[32m"` parses as a subscript on
  # ESC -- `invalid subscript` -- while the identical line in `./gate` is
  # fine because that is POSIX sh, which has no array subscripts. The
  # colour branch only runs on a terminal, so every captured-output test
  # took the `else` and this never executed until a person ran it.
  G="${ESC}[32m"; R="${ESC}[31m"; Y="${ESC}[33m"
  D="${ESC}[2m";  B="${ESC}[1m";  Z="${ESC}[0m"
else
  G=; R=; Y=; D=; B=; Z=
fi

step_begin() {
  STEP=$1; STEP_T0=$(date +%s)
  if [ "$LIVE" = 1 ]; then
    printf '  %s·%s %-10s %s…%s' "$D" "$Z" "$STEP" "$D" "$Z"
  fi
}
# Runs `$@` while the line animates, so a long build never looks like a
# hang. The frame moves, the elapsed second counts, and the crate cargo
# is on right now is read out of its own output -- a spinner that only
# spins tells you the script is alive; this tells you what it is doing.
#
# Output goes to a file rather than the terminal because the step line is
# redrawn in place and cargo's own progress would scroll it away.
SPIN_LOG=
# The last thing cargo said it was working on, reduced to two fields.
#
# awk, not sed: BSD sed has no `\|` alternation in a basic regular
# expression and matches nothing at all, silently. The first version of
# this was a BSD-incompatible sed, so every build showed the fallback
# word for its whole run and was exactly as uninformative as the static
# `...` the spinner had replaced.
#
# Two fields, never the whole line: cargo writes the crate's directory
# after the version, and that path names the operator's home directory.
# On one line so that a test can lift it out and run it against real
# cargo output rather than against a line somebody imagined.
SPIN_AWK='/^ *(Compiling|Building|Downloading|Installing|Replacing) / { sub(/^ +/, ""); last = $1 " " $2 } END { print last }'

spin_run() {
  SPIN_LOG=$(mktemp -t choir-install)
  if [ "$LIVE" != 1 ]; then
    "$@" >"$SPIN_LOG" 2>&1
    return $?
  fi
  "$@" >"$SPIN_LOG" 2>&1 &
  local pid=$! i=0 frame doing el
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  while kill -0 "$pid" 2>/dev/null; do
    i=$(( (i % 10) + 1 ))
    frame=${frames[$i]}
    el=$(( $(date +%s) - STEP_T0 ))
    doing=$(awk "$SPIN_AWK" "$SPIN_LOG" 2>/dev/null)
    printf '\r%s[2K  %s%s%s %-10s %s%-30s%s %s%ss%s' \
      "$ESC" "$Y" "$frame" "$Z" "$STEP" "$D" "${doing:-working}" "$Z" "$D" "$el" "$Z"
    sleep 0.08
  done
  wait "$pid"
}

step_end() {  # $1 status, $2 note, $3 detail
  local el=$(( $(date +%s) - STEP_T0 ))
  if [ "$LIVE" = 1 ]; then printf '\r%s[2K' "$ESC"; fi
  if [ "$1" -eq 0 ]; then
    printf '  %s✓%s %-10s %-24s %s%s%s\n' "$G" "$Z" "$STEP" "$2" "$D" "${3:-${el}s}" "$Z"
  else
    printf '  %s✗%s %-10s %s%s%s\n' "$R" "$Z" "$STEP" "$R" "$2" "$Z"
  fi
}

# The first directory on PATH that we are willing to install into.
# Order is preference: a user-owned directory before a system one, and
# never a directory PATH does not actually contain -- installing
# somewhere invisible is the failure this exists to prevent.
pick_bindir() {
  local d
  for d in "$HOME/.local/bin" "$HOME/.cargo/bin" /usr/local/bin; do
    case ":$PATH:" in *":$d:"*) echo "$d"; return 0 ;; esac
  done
  return 1
}

case "${1:-}" in

install)
  # Build, mint secrets, load the supervised LaunchAgent. Idempotent.
  if remote_node; then
    echo "the node lives on the VM now (~/.choir/node-remote): use ./choirctl deploy" >&2
    exit 1
  fi
  sh "$HERE/scripts/flip/install_node.sh" "$PORT" "${2:-choir/choir.git}"
  ;;

deploy)
  # Ship this checkout to the remote node: push, fetch, merge, rebuild,
  # reinstall, and say what is running afterwards.
  #
  # This used to be five commands an operator retyped by hand every time,
  # because `install` printed them and refused. Printing instructions is
  # how they drift: the ones it printed built with `--manifest-path`,
  # which looks equivalent to `cd` and is not -- rustup resolves
  # rust-toolchain.toml from the working directory, so that form fails on
  # a node whose account has no default toolchain, with an error naming
  # rustup rather than the flag that caused it.
  remote_node || { echo "deploy is for the remote node; use ./choirctl install here" >&2; exit 2; }
  repo="${2:-choir/choir.git}"

  # Every stage runs under `spin_run`, which sends both streams to a file
  # and animates one line. git and cargo both narrate on stderr, so a
  # stage that let its output through would scroll away the very line
  # being redrawn in place -- which is what the first version of this did
  # on its first run.
  stage() {  # $1 label, rest: command
    local label=$1; shift
    step_begin "$label"
    if ! spin_run "$@"; then
      step_end 1 "failed"
      echo >&2
      cat "$SPIN_LOG" >&2
      exit 1
    fi
  }

  stage push tunnel_up
  stage push sh "$HERE/scripts/flip/push_canonical.sh" "$PORT" "$repo"
  step_end 0 "$(git rev-parse --short HEAD)"

  # One ssh per stage rather than one for all of them: a failure names
  # the stage it happened in, and `set -e` on the remote side of a single
  # joined command would report only that something exited nonzero.
  stage fetch node_ssh 'git -C ~/choir-build fetch -q ~/.choir/repos/choir/choir.git main'
  step_end 0 "fetched"

  stage merge node_ssh 'git -C ~/choir-build merge --ff-only -q FETCH_HEAD'
  step_end 0 "$(node_ssh 'git -C ~/choir-build rev-parse --short HEAD')"

  # `cd`, not --manifest-path: see above. The stamp comes from the env
  # var because that is the path build.rs is guaranteed to rebuild on.
  stage build node_ssh 'cd ~/choir-build && CHOIR_GIT_HEAD=$(git rev-parse HEAD) cargo build --release -p choir-node -p choir-cli'
  step_end 0 "compiled"

  # A non-interactive ssh has no session bus, so `systemctl --user` needs
  # both of these exported or it fails with a DBUS complaint that names
  # nothing useful.
  stage install node_ssh 'XDG_RUNTIME_DIR=/run/user/$(id -u) DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus sh ~/choir-build/scripts/flip/install_node_linux.sh '"$PORT"' "" ~/bin ~/choir-build/target/release'
  step_end 0 "unit reloaded"

  # The receipt: what the running daemon says it is, rather than what we
  # just asked it to become.
  running=$(node_ssh 'grep -o "choir-node build [a-f0-9]*" ~/.choir/node.log | tail -1 | awk "{print \$3}"')
  wanted=$(git rev-parse HEAD | cut -c1-12)
  if [ "$running" = "$wanted" ]; then
    echo "deployed: the node is serving $running"
  else
    echo "deploy: the node reports $running but this checkout is $wanted" >&2
    exit 1
  fi
  ;;

status)
  if remote_node; then
    tunnel_up
    echo "agent:  remote ($(node_ssh 'systemctl --user is-active choir-node.service') on the node host, via tunnel)"
  elif launchctl print "gui/$(id -u)/$LABEL" > /dev/null 2>&1; then
    echo "agent:  loaded ($LABEL)"
  else
    echo "agent:  not loaded — run: ./choirctl install"
    exit 1
  fi
  # Which binary is actually serving, not merely whether something is.
  # `launchctl kickstart -k` restarts the job from launchd's cached job
  # definition, so a plist whose ProgramArguments changed can lint clean,
  # restart cleanly, and still run the old binary. An API-shaped check
  # cannot catch that when both binaries have the feature you are testing
  # for; only the path can. Reloading properly is bootout then bootstrap.
  if remote_node; then
    echo "binary: $(node_ssh 'ps -eo args | grep "[c]hoir-node" | head -1' | awk '{print $1}') (on the node host)"
  else
    echo "binary: $(ps -eo args | grep "[c]hoir-node" | head -1 | awk '{print $1}')"
  fi
  code=$(curl -s -o /dev/null -w '%{http_code}' "$(api_base)/api/view" || true)
  echo "auth:   $code on an unauthenticated /api/view (401 = auth is on)"
  view=$(curl -s -u "$(auth_user):$(auth_pass)" "$(api_base)/api/view")
  # The path above says which file is serving. This says what that file
  # was built from, which is the question "did my rebuild reach the
  # running process" actually asks. A stamp of `unknown` means the binary
  # was built without one, not that the commit is unknowable.
  built=$(printf '%s' "$view" | python3 -c 'import json,sys; b=json.load(sys.stdin).get("build",{}); print(b.get("commit","unknown"), b.get("source","?"), "dirty" if b.get("dirty") else "clean")' 2>/dev/null || echo "unknown ? ?")
  head_now=$(git -C "$HERE" rev-parse HEAD 2>/dev/null || echo unknown)
  build_commit=${built%% *}
  build_tail=${built#* }
  echo "build:  $build_commit (stamp ${build_tail%% *}, tree ${built##* })"
  if [ "$build_commit" = unknown ]; then
    echo "build:  UNSTAMPED — rebuild with ./choirctl install to make this checkable"
  elif [ "$build_commit" != "$head_now" ]; then
    echo "build:  STALE — serving $(printf '%.12s' "$build_commit"), checkout is $(printf '%.12s' "$head_now")"
  fi
  # Is the sequencer meeting the Phase-0 gate on real traffic, not in the
  # test suite. Percentiles are microseconds.
  printf '%s' "$view" | python3 -c '
import json, sys
lag = json.load(sys.stdin).get("sequencer_lag")
if not lag:
    print("lag:    not reported by this node")
    sys.exit()
ops = lag["observed_ops"]
if not ops:
    print("lag:    no ops measured since start (nothing to say yet)")
    sys.exit()
d, k = lag["durable"], lag["decision"]
print("lag:    %d ops, durable p50 %.1f ms p99 %.1f ms max %.1f ms; decision p99 %.1f ms; gate %.0f ms"
      % (ops, d["p50_us"]/1000, d["p99_us"]/1000, d["max_us"]/1000, k["p99_us"]/1000, lag["gate_us"]/1000))
if d["breaches"]:
    print("lag:    %d BREACHES over the gate — see ~/.choir/repos/.choir/lag.jsonl" % d["breaches"])
if lag["log_write_failures"]:
    print("lag:    lag log unwritable (%s)" % lag["log_error"])
' 2>/dev/null || echo "lag:    unreadable"
  echo "view:   $view"
  if remote_node; then
    # The backup relation is inverted: this machine holds the pull.
    if [ -f "$BACKUP/ops.jsonl" ]; then
      echo "backup: $(wc -l < "$BACKUP/ops.jsonl" | tr -d ' ') ops pulled, last $(date -r "$BACKUP/ops.jsonl" '+%F %H:%M')"
    else
      echo "backup: NEVER PULLED — run: ./choirctl pull-backup"
    fi
  else
    mirror_line
    # Outcome is not currency: a run can succeed and still leave the mirror
    # a commit behind if it was started before the last commit landed.
    if [ -f "$RECEIPT" ]; then
      mirrored=$(awk 'NR==1{print $3}' "$RECEIPT")
      head=$(git -C "$HERE" rev-parse HEAD 2>/dev/null || echo unknown)
      [ "$mirrored" = "$head" ] || echo "mirror: BEHIND — mirrored $mirrored, HEAD is $head"
    fi
  fi
  ;;

stop)
  # Unloads for this boot only: the plist stays in LaunchAgents, so
  # launchd starts it again at next login. Use uninstall to end it.
  if remote_node; then
    echo "the node lives on the VM now; stop it there: systemctl --user stop choir-node" >&2
    exit 1
  fi
  launchctl bootout "gui/$(id -u)/$LABEL"
  echo "stopped $LABEL — but it returns at next login"
  echo "to end it for good: ./choirctl uninstall"
  ;;

uninstall)
  # Stop it and remove the plist, so it does not come back. Data is
  # deliberately kept: $STATE holds the keys, the repos, and the op log.
  if remote_node; then
    echo "the node lives on the VM now; nothing to uninstall here" >&2
    exit 1
  fi
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$HOME/Library/LaunchAgents/$LABEL.plist"
  echo "uninstalled $LABEL (agent unloaded, plist removed)"
  echo "kept: $STATE — keys, repos and the op log"
  echo "to erase that too, by hand: rm -rf $STATE"
  ;;

push)
  # Local repo -> the choir node, as the canonical remote (--all + --tags).
  remote_node && tunnel_up
  sh "$HERE/scripts/flip/push_canonical.sh" "$PORT" "${2:-choir/choir.git}"
  ;;

publish-release)
  # D79. Puts the release archives on the node's shelf, so the install
  # command on our own front door fetches from the node it names. Runs
  # on the node host in remote mode, because that is where the shelf is
  # and copying tarballs through this laptop is a detour.
  tag=${2:-latest}
  # Where CI publishes, as `owner/name`, in a file rather than in this
  # script: an installation's forge is a local fact, and a tracked
  # default is a slug every other operator would have to remember to
  # change.
  if [ ! -f "$STATE/release-repo" ]; then
    echo "no $STATE/release-repo — write the owner/name CI publishes to, e.g." >&2
    echo "  echo owner/name > $STATE/release-repo" >&2
    exit 2
  fi
  from=$(sed -n 1p "$STATE/release-repo")
  if remote_node; then
    node_ssh "sh -s -- '$from' '$tag' \"\$HOME/.choir/downloads\"" \
      < "$HERE/scripts/flip/publish_release.sh"
    echo "shelf: run ./choirctl deploy so the daemon is started with --downloads-dir"
    exit 0
  fi
  sh "$HERE/scripts/flip/publish_release.sh" "$from" "$tag" "$STATE/downloads"
  ;;

mirror)
  # Repo -> the private Forgejo follower on the mirror VM.
  if remote_node; then
    follower_feed
    exit 0
  fi
  sh "$HERE/scripts/push_mirror.sh"
  ;;

review)
  # First seat of a landing round: open a review naming the exact oid a
  # landing will move a protected ref to. Tunnel-aware, because the raw
  # CLI command at a dead forward burned three retries in one afternoon
  # — the command was right every time, the port was not listening.
  #   choirctl review <id> <oid> [repo:ref]
  [ $# -ge 3 ] || { echo "usage: choirctl review <id> <oid> [repo:ref]" >&2; exit 2; }
  remote_node && tunnel_up
  "$(choir_bin)" --auth-file "$STATE/auth" --auth-user "$(auth_user)" \
    review "$(api_base)" "$STATE/agent.key" \
    "${CHOIR_REVIEW_CHANNEL:-op/codex}" "$2" "$3" \
    --ref "${4:-choir/choir.git:refs/heads/main}"
  ;;

verdict)
  # A reviewer seat of the round. The reviewer key stays operator-held
  # and operator-invoked; this only removes the boilerplate around it,
  # not the second pair of hands D24 actually wants.
  #   choirctl verdict <reviewer> <id> <approve|request-changes> [note]
  [ $# -ge 4 ] || { echo "usage: choirctl verdict <reviewer> <id> <approve|request-changes> [note]" >&2; exit 2; }
  remote_node && tunnel_up
  # No array for the optional note: this script is documented to run as
  # `./choirctl`, and macOS sh is bash 3.2, where expanding an
  # empty array under `set -u` dies with `note[@]: unbound variable` —
  # which killed both verdict seats of a real landing round.
  if [ $# -ge 5 ]; then
    "$(choir_bin)" --auth-file "$STATE/auth" --auth-user "$(auth_user)" \
      verdict "$(api_base)" "$STATE/review-$2.key" "$2/reviewer" \
      "$3" "$4" "$5"
  else
    "$(choir_bin)" --auth-file "$STATE/auth" --auth-user "$(auth_user)" \
      verdict "$(api_base)" "$STATE/review-$2.key" "$2/reviewer" \
      "$3" "$4"
  fi
  ;;

abandon)
  # Operator retention: settle a stale, incomplete review as lapsed and
  # unapproved. The node key signs it and the node key never leaves the
  # node host, so in remote mode the CLI runs there, on-box.
  #   choirctl abandon <id>
  [ $# -ge 2 ] || { echo "usage: choirctl abandon <id>" >&2; exit 2; }
  if remote_node; then
    node_ssh "\$HOME/bin/choir --auth-file \$HOME/.choir/auth --auth-user choir abandon $(api_base) \$HOME/.choir/repos/.choir/node.key '$2'"
    exit 0
  fi
  "$(choir_bin)" --auth-file "$STATE/auth" --auth-user "$(auth_user)" \
    abandon "$(api_base)" "$STATE/repos/.choir/node.key" "$2"
  ;;

sync)
  if remote_node; then
    # Same D21 order, new topology: canonical first (through the
    # tunnel), follower second (on-box, node repo -> Forgejo), then the
    # offsite copy of the log — which is now this machine, pulling.
    tunnel_up
    sh "$HERE/scripts/flip/push_canonical.sh" "$PORT" "${2:-choir/choir.git}"
    # A follower failure is reported but does not block the backup pull:
    # the log copy matters more than the ref mirror, and the failure is
    # already loud on this run's own output.
    follower_feed || echo "sync: follower leg failed — continuing to the backup pull" >&2
    sh "$HERE/scripts/flip/pull_backup.sh"
    exit 0
  fi
  # The post-flip order, in one command: canonical first, follower
  # second. `set -e` stops here if the canonical push fails, so the
  # mirror can never get ahead of the node (D21 single-canonical).
  sh "$HERE/scripts/flip/push_canonical.sh" "$PORT" "${2:-choir/choir.git}"

  # Whatever the previous run did, before starting another one over it.
  mirror_line

  # The follower runs detached. Ordering is preserved for free: this line
  # is only reached after the canonical push returned, and `set -e` means
  # a failed canonical push never gets here, so the mirror still cannot
  # get ahead of the node (D21 single-canonical). What backgrounding
  # changes is only who waits, and nothing waits on a follower.
  printf 'started %s %s\n' "$(date +%s)" "$(git -C "$HERE" rev-parse HEAD)" > "$RECEIPT"
  nohup sh "$HERE/scripts/push_mirror.sh" >> "$RECEIPT" 2>&1 &
  echo "mirror: running in background -> $RECEIPT (see: ./choirctl status)"
  ;;

verify-backup)
  # Delegates. The checks are `choir backup verify` now, because the
  # release ships `choir` and has never shipped this script -- a beta
  # user following docs/runbook-restore.md had no ./choirctl to run.
  # scripts/flip/verify_backup.sh stays on disk as the shell fallback;
  # nothing calls it.
  "$(choir_bin)" backup verify "${2:-$BACKUP}"
  ;;

restore-from-backup)
  # Delegates, for the same reason as verify-backup above. Exit codes are
  # unchanged and load-bearing: 3 still means an operator decision, and
  # the runbook still tells you to supply the secret and re-run.
  [ $# -ge 3 ] || { echo "usage: choirctl restore-from-backup <backup-dir> <target-root>" >&2; exit 2; }
  "$(choir_bin)" backup restore "$2" "$3"
  ;;

pull-backup)
  # Node host -> this machine: the offsite copy of the live log, after
  # the host move. Self-verifying (checksum, prefix, seq contiguity).
  sh "$HERE/scripts/flip/pull_backup.sh" "${2:-}"
  ;;

schedule-backup)
  # Load a LaunchAgent that runs pull-backup on an interval (default
  # hourly), so the offsite copy stops depending on manual syncs.
  sh "$HERE/scripts/flip/install_pull_timer.sh" "${2:-}"
  ;;

logs)
  if remote_node; then
    node_ssh "tail -n ${2:-30} '.choir/node.log'"
    exit 0
  fi
  tail -n "${2:-30}" "$STATE/node.log"
  ;;

url)
  # Clone/push URL with credentials, for pasting into git or curl. In
  # remote mode 127.0.0.1 is the tunnel, so the URL is unchanged.
  remote_node && tunnel_up
  echo "$(api_base)/${2:-choir/choir.git}" | sed "s|://|://$(auth_user):$(auth_pass)@|"
  ;;

people)
  # D72's console. The three things this script used to be the only way
  # to do -- see who is here, mint a link, answer somebody who asked --
  # are a page now, so this command exists to open it rather than to do
  # any of them. It prints the address in every case: a browser that does
  # not open is not a reason to be left without the URL.
  tunnel_up
  url="$(api_base)/people"
  echo "$url"
  command -v open >/dev/null 2>&1 && open "$url"
  ;;

invite)
  # D57. Prints the join link and nothing else, because the link is the
  # whole artefact: it gets pasted into a chat window, and anything else
  # printed beside it invites pasting that too. The `id:secret` pair the
  # API also returns is for `curl -u`; it is not what a person receives.
  #
  # The same mint is a form on `./choirctl people`, which is the one to
  # reach for: it lists the repositories rather than asking you to spell
  # one, and it is where the queue of people asking to be let in is.
  [ $# -ge 3 ] || { echo "usage: choirctl invite <name> <owner/repo> [read|write]" >&2; exit 2; }
  tunnel_up
  level=${4:-write}
  repo="$2"
  target="$3"
  # `.git` is how the ACL spells a repository, and leaving it off is the
  # mistake that mints an invite granting nothing. Added here rather than
  # refused, since there is one right answer.
  case "$target" in *.git) ;; *) target="$target.git" ;; esac
  curl -sS -u "$(auth_user):$(auth_pass)" -X POST \
    -d "{\"user\":\"$repo\",\"grants\":[\"$target $level\"]}" \
    "$(api_base)/api/accounts/invite" \
  | python3 -c 'import sys,json
answer = json.load(sys.stdin)
if "join_url" not in answer:
    sys.exit("choirctl invite: " + answer.get("error", str(answer)))
print(answer["join_url"])'
  ;;

install-cli)
  # Puts `choir` on PATH as a real file. Not a symlink into
  # target/release: that tracks rebuilds for free and dangles the moment
  # anyone runs `cargo clean` or moves the checkout, and a broken PATH
  # entry fails as "no such file" rather than "not installed".
  printf '\n  %schoir%s %sinstall the CLI%s\n\n' "$B" "$Z" "$D" "$Z"

  step_begin target
  if ! BINDIR=$(pick_bindir); then
    step_end 1 "no writable directory on PATH"
    printf '\n  %sNone of ~/.local/bin, ~/.cargo/bin or /usr/local/bin is on your PATH.%s\n' "$Y" "$Z"
    printf '  Add one and re-run:\n\n'
    printf '    %secho '"'"'export PATH="$HOME/.local/bin:$PATH"'"'"' >> ~/.zshrc%s\n\n' "$D" "$Z"
    exit 1
  fi
  ROOT=${BINDIR%/bin}
  case "$BINDIR" in
    "$HOME"/*) SHOWN="~${BINDIR#$HOME}" ;;
    *) SHOWN=$BINDIR ;;
  esac
  step_end 0 "$SHOWN" "on PATH"

  step_begin build
  # `cargo build`, not `cargo install`. Both produce the same binary, but
  # this is the artifact `./gate` and every ordinary `cargo build` in
  # this checkout already produced, so a tree that is up to date finishes
  # in a fraction of a second instead of rebuilding the crate to install
  # it. The install is then a copy, below.
  if ! spin_run cargo build --release -p choir-cli; then
    step_end 1 "build failed"
    printf '\n'; tail -25 "$SPIN_LOG"; printf '\n'
    exit 1
  fi
  step_end 0 "choir, choir-mcp"

  step_begin install
  # `install` rather than `cp`: it replaces the target atomically-ish by
  # writing and renaming, so a `choir` running from this path while the
  # copy happens does not get a half-written file (ETXTBSY is the same
  # hazard the landing round deals with on the node host).
  mkdir -p "$BINDIR"
  for b in choir choir-mcp; do
    if ! install -m 755 "$HERE/target/release/$b" "$BINDIR/$b" 2>/dev/null; then
      step_end 1 "cannot write to $BINDIR"
      exit 1
    fi
  done
  step_end 0 "2 binaries"

  step_begin verify
  # Installing it and finding it are different claims. An older `choir`
  # earlier on PATH would shadow this one, and every symptom afterwards
  # would look like the new binary being wrong.
  FOUND=$(command -v choir 2>/dev/null || true)
  if [ -z "$FOUND" ]; then
    step_end 1 "installed but not found on PATH"
    exit 1
  fi
  if [ "$FOUND" != "$BINDIR/choir" ]; then
    step_end 1 "shadowed by $FOUND"
    printf '\n  %sAnother choir earlier on PATH wins: %s%s\n' "$Y" "$FOUND" "$Z"
    printf '  Remove it, or put %s first.\n\n' "$BINDIR"
    exit 1
  fi
  choir --help >/dev/null 2>&1 || { step_end 1 "installed binary does not run"; exit 1; }
  # Asked of the binary, not of the directory. `git rev-parse` here would
  # report the commit the *repository* is on, which is what this step
  # exists to doubt: a build that failed, or an install that copied
  # something else, leaves the repository at the same commit either way.
  # The stamp is baked in at compile time and cannot be restated by a
  # later checkout.
  STAMP=$(choir --version 2>/dev/null | sed -n 's/^choir build \([0-9a-f]*\).*/\1/p')
  HEAD=$(git -C "$HERE" rev-parse HEAD 2>/dev/null || echo unknown)
  if [ -z "$STAMP" ]; then
    step_end 0 "runs, build unstamped"
  elif [ "${HEAD#"$STAMP"}" != "$HEAD" ]; then
    step_end 0 "runs, from $STAMP"
  else
    step_end 0 "runs, from $STAMP"
    printf '\n  %sThe installed binary reports %s; this checkout is at %s.%s\n' \
      "$Y" "$STAMP" "$(printf '%.12s' "$HEAD")" "$Z"
    printf '  %sThe build did not reach the copy that just installed.%s\n\n' "$D" "$Z"
  fi

  printf '\n  %sinstalled%s  %s%s/choir%s\n\n' "$G" "$Z" "$D" "$SHOWN" "$Z"
  printf '  %schoir --help%s            the command index\n' "$B" "$Z"
  printf '  %schoir <command> --help%s  one command'"'"'s arguments\n\n' "$B" "$Z"
  printf '  %sRe-run this after changing the CLI; the installed copy does not\n  track your edits.%s\n\n' "$D" "$Z"
  ;;

*)
  cat <<USAGE
./choirctl <command>

  install [repo]   build + mint secrets + load the supervised daemon
  deploy [repo]    push, rebuild and reinstall the remote node, in one
  install-cli      put the choir CLI on your PATH as a real binary
  status           is it running, is auth on, what does the view say
  logs [n]         last n lines of the daemon log
  stop             unload it for now (it returns at next login)
  uninstall        unload it and remove the agent (data kept)

  sync [repo]      push to the node, then the follower (the usual one)
  push [repo]      push this repo to the node only (--all and --tags)
  mirror           push to the pre-flip Forgejo follower only (legacy)
  publish-release [tag]   put the release archives on the node's /download/ shelf
  url [repo]       clone/push URL including credentials

  people           open the console: who is here, who is asking, invites
  invite <name> <owner/repo> [read|write]        mint a link, no browser

  review <id> <oid> [repo:ref]                   open a landing review
  verdict <reviewer> <id> <verdict> [note]       cast a reviewer verdict
  abandon <id>     settle a stale incomplete review as lapsed-unapproved
  verify-backup    check a backup is restorable (-> choir backup verify)
  pull-backup      fetch the log copy from the node host (remote mode)
  schedule-backup [secs]   pull-backup on a launchd interval (default 3600)
  restore-from-backup <backup-dir> <target-root>
                   rebuild a node and prove it (-> choir backup restore)

Port is $PORT (override with CHOIR_PORT).
Runbooks: scripts/flip/RUNBOOK.md (install), docs/runbook-restore.md (restore)
USAGE
  ;;
esac
